[Unit]
Description=MusicWeb ACE-Step Generator
After=network.target

[Service]
User=legion
WorkingDirectory=/home/legion/legionprojects/musicweb
ExecStart=/usr/bin/python3 -m uvicorn musicweb:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
